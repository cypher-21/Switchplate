{
  "$schema": "https://raw.githubusercontent.com/nicegui/Tauri/dev/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Switchplate",
  "version": "1.0.0",
  "identifier": "dev.switchplate.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Switchplate",
        "width": 520,
        "height": 210,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false,
        "visible": false,
        "x": 700,
        "y": 54
      },
      {
        "label": "settings",
        "title": "Switchplate Settings",
        "width": 780,
        "height": 520,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}

{
  "$schema": "https://raw.githubusercontent.com/nicegui/Tauri/dev/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "OpenCode Notch",
  "version": "0.1.0",
  "identifier": "dev.opencode.notch",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "notch",
        "title": "OpenCode Notch",
        "width": 440,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false,
        "visible": false,
        "x": 740,
        "y": 16
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
